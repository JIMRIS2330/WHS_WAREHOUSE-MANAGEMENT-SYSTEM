# =============================================================================
# WMS BACKEND SERVER ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================

# Server Port
PORT=5000

# Environment Mode (development / test / production)
NODE_ENV=development

# Frontend Client Origin URL for CORS configuration
CLIENT_URL=http://localhost:5173

# Cryptographic secret for signing JWT access tokens (Minimum 32 random characters)
JWT_SECRET=dev_jwt_secret_warehouse_mgmt_system_2026_super_secure_key

# JWT Access Token Expiry duration (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1h

# Refresh Token Expiration in days
REFRESH_TOKEN_EXPIRES_DAYS=7

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA)
# Example local docker: postgresql://postgres:postgres@localhost:5432/wms_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wms_db?schema=public
